##############################################################################
#  probe_wall_check.cdl
#  NX CAM User Defined Event: Probe wall check (Fanuc 0i-MF Plus + Hexagon)
#  Handler: proc MOM_probe_wall_check in probe_wall_check.tcl
#  Syntax follows NX ude.cdl / Fanuc_custom.cdl / Robotics.cdl (TYPE p).
#  Created 2026-10-31 for Max Alen (WhiteM93).
#  M60/M61 field: Russian text, ENCODING Windows-1251 (as probe_omp.cdl).
##############################################################################

MACHINE Default

EVENT probe_wall_check
{
   POST_EVENT "probe_wall_check"
   UI_LABEL "Probe wall check"
   CATEGORY MILL

   PARAM command_status
   {
      TYPE o
      DEFVAL "Active"
      OPTIONS "Active","Inactive","User Defined"
      UI_LABEL "Status"
   }

   PARAM pwc_tool
   {
      TYPE i
      DEFVAL "20"
      UI_LABEL "Probe tool number (T and H)"
   }

   PARAM pwc_feed
   {
      TYPE d
      DEFVAL "1000.0"
      TOGGLE Off
      UI_LABEL "Feed override"
   }

   PARAM pwc_m60
   {
      TYPE o
      DEFVAL "Да"
      OPTIONS "Да","Нет"
      UI_LABEL "M60/M61 (без шпинделя)"
   }

   PARAM pwc_wcs
   {
      TYPE o
      DEFVAL "G54"
      OPTIONS "G54","G55","G56","G57","G58","G59","G54.1"
      UI_LABEL "Work offset"
   }

   PARAM pwc_wcs_p
   {
      TYPE i
      DEFVAL "1"
      UI_LABEL "G54.1 P number"
   }

   PARAM pwc_point1
   {
      TYPE p
      UI_LABEL "Point 1"
   }

   PARAM pwc_point2
   {
      TYPE p
      UI_LABEL "Point 2"
   }

   PARAM pwc_z_touch
   {
      TYPE d
      DEFVAL "15.0"
      UI_LABEL "Z touch"
   }

   PARAM pwc_z_safe
   {
      TYPE d
      DEFVAL "50.0"
      UI_LABEL "Z safe"
   }

   PARAM pwc_touch_dist
   {
      TYPE d
      DEFVAL "20.0"
      UI_LABEL "Touch distance"
   }

   PARAM pwc_direction
   {
      TYPE o
      DEFVAL "Y-"
      OPTIONS "X+","X-","Y+","Y-"
      UI_LABEL "Direction"
   }

   PARAM pwc_tolerance
   {
      TYPE d
      DEFVAL "0.1"
      UI_LABEL "Tolerance"
   }

   PARAM pwc_var1
   {
      TYPE i
      DEFVAL "190"
      UI_LABEL "Var 1 (152-199)"
   }

   PARAM pwc_var2
   {
      TYPE i
      DEFVAL "191"
      UI_LABEL "Var 2 (152-199)"
   }

   PARAM pwc_var_diff
   {
      TYPE i
      DEFVAL "192"
      UI_LABEL "Var diff (152-199)"
   }
}
