##############################################################################
#  probe_set.cdl
#  NX CAM User Defined Events: probe set Z top / boss center / hole center
#  (Fanuc 0i-MF Plus + Hexagon). Handlers: probe_set.tcl
#  Created 2026-10-31 for Max Alen.
#  M60/M61 field: Russian text, ENCODING Windows-1251 (as probe_omp.cdl).
##############################################################################

MACHINE Default

EVENT probe_set_z_top
{
   POST_EVENT "probe_set_z_top"
   UI_LABEL "Probe set Z top"
   CATEGORY MILL

   PARAM command_status
   {
      TYPE o
      DEFVAL "Active"
      OPTIONS "Active","Inactive","User Defined"
      UI_LABEL "Status"
   }

   PARAM pst_point
   {
      TYPE p
      UI_LABEL "Point X Y (Z ignored)"
   }

   PARAM pst_z_safe
   {
      TYPE d
      DEFVAL "50.0"
      UI_LABEL "Z safe"
   }

   PARAM pst_z_appr
   {
      TYPE d
      DEFVAL "10.0"
      UI_LABEL "Z approach"
   }

   PARAM pst_z_nom
   {
      TYPE d
      DEFVAL "0.0"
      UI_LABEL "Z nominal"
   }

   PARAM pst_feed
   {
      TYPE d
      DEFVAL "1000.0"
      TOGGLE Off
      UI_LABEL "Feed override"
   }

   PARAM pst_m60
   {
      TYPE o
      DEFVAL "Да"
      OPTIONS "Да","Нет"
      UI_LABEL "M60/M61 (без шпинделя)"
   }

   PARAM pst_w
   {
      TYPE i
      DEFVAL "1"
      UI_LABEL "Zero W (1-6 = G54-G59, -n = G54.1 Pn)"
   }

   PARAM pst_tool
   {
      TYPE i
      DEFVAL "20"
      UI_LABEL "Probe tool number (T and H)"
   }
}

EVENT probe_set_boss_center
{
   POST_EVENT "probe_set_boss_center"
