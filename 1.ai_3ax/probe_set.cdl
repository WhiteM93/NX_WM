      UI_LABEL "Point X Y (Z ignored)"
   }

   PARAM pst_d
   {
      TYPE d
      DEFVAL "50.0"
      UI_LABEL "Diameter D"
   }

   PARAM pst_z_depth
   {
      TYPE d
      DEFVAL "-10.0"
      UI_LABEL "Z depth"
   }

