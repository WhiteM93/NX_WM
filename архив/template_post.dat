#####################################################################
# template_post.dat — список постов (всё кроме архива)
#####################################################################
# Посты WM_TOOL_LIST и 6.WM_TOOL_LIST используют шаблоны из корня:
#   post_tool_list_html.tpl, post_tool_list_text.tpl (цикл SETUP→PROGRAMVIEW→TOOL).
# Стиль HTML задаётся в .tcl (ShopDoc_Header_html, Setup_Header_html).
#####################################################################

# --- Основные посты ---
1.ai_3ax,${UGII_CAM_POST_DIR}1.ai_3ax\ai_3ax.tcl,${UGII_CAM_POST_DIR}1.ai_3ax\ai_3ax.def

2.Cutter_CH,${UGII_CAM_POST_DIR}2.Cutter CH\Cutter CH.tcl,${UGII_CAM_POST_DIR}2.Cutter CH\Cutter CH.def

3.Sicono_cnc,${UGII_CAM_POST_DIR}3.Sicono\cnc_0.1.tcl,${UGII_CAM_POST_DIR}3.Sicono\cnc_0.1.def

4.KVL_650,${UGII_CAM_POST_DIR}4.KVL_650\KVL_650.tcl,${UGII_CAM_POST_DIR}4.KVL_650\KVL_650.def

5.Fanuc_4ax,${UGII_CAM_POST_DIR}5.Fanuc_4ax\Fanuc_4ax.tcl,${UGII_CAM_POST_DIR}5.Fanuc_4ax\Fanuc_4ax.def

# --- Список инструментов (WM) в корне: WM_TOOL_LIST_html.tcl, WM_TOOL_LIST_text.tcl, WM_TOOL_LIST.def, WM_TOOL_LIST.tpl ---
WM_TOOL_LIST(html),${UGII_CAM_POST_DIR}WM_TOOL_LIST_html.tcl,${UGII_CAM_POST_DIR}WM_TOOL_LIST.def

# --- Список инструментов (WM), папка 6 ---
6.WM_TOOL_LIST(html),${UGII_CAM_POST_DIR}6.WM_TOOL_LIST\WM_TOOL_LIST_html.tcl,${UGII_CAM_POST_DIR}6.WM_TOOL_LIST\WM_TOOL_LIST.def

# --- Список операций (WM), папка 7 ---
7.WM_OPERATION_LIST(html),${UGII_CAM_POST_DIR}7.WM_OPERATION_LIST\WM_OPERATION_LIST_html.tcl,${UGII_CAM_POST_DIR}7.WM_OPERATION_LIST\WM_OPERATION_LIST.def
